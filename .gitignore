# --- Secrets -----------------------------------------------------------------
# .env has never been committed and must stay that way. .env.example is the
# template and IS tracked.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json
secrets.*

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# --- Test / lint / type caches -----------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# --- Run output --------------------------------------------------------------
# Reconciliation results are regenerated by a single command and are never a
# source of truth; committing them would let stale numbers outlive the code.
out/
*.log
*.jsonl
!data/**/*.jsonl

# --- Data --------------------------------------------------------------------
# The three benchmark datasets under data/datasets/ ARE committed: they are the
# exam this project is scored against, they regenerate byte-identically, and CI
# fails if they drift. Anything else under data/ is somebody's real export and
# must never be uploaded.
/data/uploads/
/data/*.csv
/data/*.json

# --- Editors / tooling -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# --- OS ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
data/*.db*
