# Everything below is OPTIONAL. With no .env at all the product is fully
# functional: the residual resolver falls back to a deterministic heuristic.

# --- LLM residual resolver (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LLM_MODEL=claude-sonnet-5
LLM_INPUT_USD_PER_MTOK=3.0
LLM_OUTPUT_USD_PER_MTOK=15.0

# --- Razorpay, TEST MODE ONLY ---------------------------------------------
# dashboard.razorpay.com -> switch to Test Mode -> Settings -> API Keys.
# A key not starting with rzp_test_ is REFUSED: a demo must never touch real
# customer data, and there is deliberately no override.
# Then: pip install razorpay && python scripts/verify_razorpay.py
# Full walkthrough: docs/RAZORPAY.md
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- matcher tuning ---
AMOUNT_TOLERANCE_PAISE=100     # 1.00 rupee of cross-source rounding slack
DATE_TOLERANCE_DAYS=3
SETTLEMENT_LAG_DAYS=2          # Razorpay standard T+2 payout
RESOLVER_ACCEPT_THRESHOLD=0.72
